---
import Base from '@/layouts/Base.astro';
import IntestazionePagina from '@/components/IntestazionePagina.astro';
---

<Base titolo="Pagina non trovata" descrizione="La pagina cercata non esiste o è stata spostata.">
  <IntestazionePagina
    titolo="Questa pagina non c'è"
    intro="Forse il link è vecchio o l'indirizzo ha un errore di battitura. Le pagine del sito sono tutte nel menu in alto."
  >
    <div class="azioni">
      <a class="pulsante" href="/">Torna alla home</a>
      <a class="pulsante pulsante--vuoto" href="/realizzazioni/">Vedi le realizzazioni</a>
    </div>
  </IntestazionePagina>
</Base>

<style>
  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
