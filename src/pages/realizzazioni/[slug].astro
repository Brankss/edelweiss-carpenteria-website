---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import IntestazionePagina from '@/components/IntestazionePagina.astro';
import Galleria from '@/components/Galleria.astro';
import SchedaProgetto from '@/components/SchedaProgetto.astro';
import { etichetteCategoria, fotoDi, luogoDi, realizzazioni, type Realizzazione } from '@/lib/foto';

export async function getStaticPaths() {
  const tutte = await realizzazioni();
  return tutte.map((r) => ({ params: { slug: r.id }, props: { r, tutte } }));
}

interface Props {
  r: Realizzazione;
  tutte: Realizzazione[];
}
const { r, tutte } = Astro.props;
const { Content } = await render(r);
const foto = fotoDi(r.data.cartella);
const luogo = luogoDi(r);
const copertina = foto[r.data.copertina - 1]!;
const altri = tutte
  .filter((x) => x.id !== r.id && x.data.categoria === r.data.categoria)
  .concat(tutte.filter((x) => x.data.categoria !== r.data.categoria && x.data.inEvidenza))
  .slice(0, 3);

const servizioCategoria: Record<string, { url: string; nome: string }> = {
  tetti: { url: '/tetti-in-legno/', nome: 'Tetti in legno' },
  case: { url: '/case-in-legno/', nome: 'Case in legno' },
  sopraelevazioni: { url: '/sopraelevazioni-in-legno/', nome: 'Sopraelevazioni in legno' },
  facciate: { url: '/facciate-in-legno/', nome: 'Facciate in legno' },
  'su-misura': { url: '/tettoie-e-carport/', nome: 'Tettoie e lavori su misura' },
};
const servizio = servizioCategoria[r.data.categoria]!;
const url = `/realizzazioni/${r.id}/`;
const briciole = [
  { nome: 'Realizzazioni', url: '/realizzazioni/' },
  { nome: r.data.titolo, url },
];
const descrizione = `${r.data.titolo}${luogo ? ` (${luogo})` : ''}: ${r.data.sintesi} Un lavoro di Edelweiss Carpenteria.`;
---

<Base titolo={r.data.titolo} descrizione={descrizione} immagine={copertina} briciole={briciole}>
  <IntestazionePagina titolo={r.data.titolo} intro={r.data.sintesi} briciole={briciole} foto={copertina} alt={`${r.data.titolo}: vista del cantiere`} />

  <section class="sezione progetto">
    <div class="contenitore progetto__griglia">
      <dl class="progetto__dati">
        {
          luogo && (
            <div>
              <dt>Luogo</dt>
              <dd class="numeri">{luogo}</dd>
            </div>
          )
        }
        <div>
          <dt>Tipo di lavoro</dt>
          <dd>{etichetteCategoria[r.data.categoria]}</dd>
        </div>
        <div>
          <dt>Servizio</dt>
          <dd><a href={servizio.url}>{servizio.nome}</a></dd>
        </div>
      </dl>
      <div class="prosa progetto__testo">
        <Content />
      </div>
    </div>
  </section>

  <section class="sezione">
    <div class="contenitore">
      <Galleria foto={foto} titolo={r.data.titolo} />
    </div>
  </section>

  <section class="sezione altri" aria-labelledby="altri-titolo">
    <div class="contenitore">
      <div class="altri__testa">
        <h2 id="altri-titolo" class="t-h2">Altri lavori</h2>
        <a class="collegamento" href="/realizzazioni/">Tutte le realizzazioni</a>
      </div>
      <ul role="list" class="altri__griglia">
        {
          altri.map((x) => (
            <li>
              <SchedaProgetto r={x} sizes="(min-width: 64rem) 31vw, (min-width: 40rem) 50vw, 100vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .progetto__griglia {
    display: grid;
    gap: 2.5rem;
  }
  .progetto__dati {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .progetto__dati dt {
    font-size: var(--t-piccolo);
    color: var(--testo-2);
  }
  .progetto__dati dd {
    margin: 0.2rem 0 0;
    font-size: 1.125rem;
  }
  .progetto__dati a {
    display: inline-block;
    padding-block: 0.2rem;
    text-decoration-color: var(--cuoio);
  }
  .progetto__dati a:hover {
    color: var(--cuoio);
  }
  .progetto__testo {
    font-size: var(--t-lead);
    line-height: 1.55;
  }
  @media (min-width: 64rem) {
    .progetto__griglia {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 4rem;
    }
  }
  .altri__testa {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .altri__griglia {
    display: grid;
    gap: 3rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .altri__griglia {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .altri__griglia {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
