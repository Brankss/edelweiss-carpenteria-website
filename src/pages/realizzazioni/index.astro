---
import Base from '@/layouts/Base.astro';
import IntestazionePagina from '@/components/IntestazionePagina.astro';
import SchedaProgetto from '@/components/SchedaProgetto.astro';
import { etichetteCategoria, fotoDi, realizzazioni } from '@/lib/foto';

const lavori = await realizzazioni();
const categorie = Object.entries(etichetteCategoria).filter(([k]) => lavori.some((r) => r.data.categoria === k));
// Filtro senza JavaScript: il radio selezionato nasconde i lavori delle altre categorie (:has)
const filtro = categorie
  .map(([k]) => `.archivio:has(input[value="${k}"]:checked) .archivio__voce:not(:has([data-categoria="${k}"])) { display: none; }`)
  .join('\n');
---

<Base
  titolo="Realizzazioni: tetti, case e facciate in legno"
  descrizione="Tetti in legno, sopraelevazioni, case in XLAM, facciate e lavori su misura realizzati da Edelweiss Carpenteria in Trentino e nel Nord Italia."
  immagine={fotoDi('sopraelevazione-cadore')[0]}
  briciole={[{ nome: 'Realizzazioni', url: '/realizzazioni/' }]}
>
  <style is:inline set:html={filtro}></style>
  <IntestazionePagina
    titolo="Realizzazioni"
    intro="Tetti, sopraelevazioni, facciate, case al grezzo e lavori su misura degli ultimi anni. Le foto sono scattate in cantiere dalla nostra squadra."
    briciole={[{ nome: 'Realizzazioni', url: '/realizzazioni/' }]}
  />

  <section class="archivio" aria-label="Elenco dei lavori">
    <div class="contenitore">
      <fieldset class="filtri">
        <legend class="visually-hidden">Mostra i lavori per tipo</legend>
        <label class="filtro"><input type="radio" name="categoria" value="tutti" checked /><span>Tutti</span></label>
        {
          categorie.map(([k, v]) => (
            <label class="filtro">
              <input type="radio" name="categoria" value={k} />
              <span>{v}</span>
            </label>
          ))
        }
      </fieldset>

      <ul class="archivio__griglia" role="list">
        {
          lavori.map((r, i) => (
            <li class="archivio__voce">
              <SchedaProgetto r={r} livello="h2" prioritaria={i < 2} sizes="(min-width: 80rem) 30vw, (min-width: 40rem) 46vw, 100vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .archivio {
    padding-bottom: var(--sezione);
  }
  .filtri {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 clamp(2rem, 4vw, 3.5rem);
    padding: 0;
    border: 0;
  }
  .filtro {
    position: relative;
  }
  .filtro input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .filtro span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    font-size: var(--t-piccolo);
    color: var(--testo-2);
    border: 1px solid var(--linea-forte);
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }
  .filtro:hover span {
    color: var(--testo);
    border-color: var(--testo-2);
  }
  .filtro input:checked + span {
    color: var(--fondo);
    background: var(--cuoio);
    border-color: var(--cuoio);
  }
  .filtro input:focus-visible + span {
    outline: 2px solid var(--cuoio);
    outline-offset: 3px;
  }
  .archivio__griglia {
    display: grid;
    gap: 3rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .archivio__griglia {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 80rem) {
    .archivio__griglia {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 4.5rem;
    }
  }
</style>
