---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import IntestazionePagina from '@/components/IntestazionePagina.astro';
import { etichetteCategoria, fotoDi, luogoDi, realizzazioni } from '@/lib/foto';

const lavori = await realizzazioni();
const categorie = Object.entries(etichetteCategoria).filter(([k]) => lavori.some((r) => r.data.categoria === k));
const filtro = categorie
  .map(([k]) => `.archivio:has(input[value="${k}"]:checked) .archivio__voce:not([data-categoria="${k}"]) { display: none; }`)
  .join('\n');
---

<Base
  titolo="Realizzazioni: tetti, case e facciate in legno"
  descrizione="Tetti in legno, sopraelevazioni, case in XLAM, facciate e lavori su misura realizzati da Edelweiss Carpenteria in Trentino e nel Nord Italia."
  immagine={fotoDi('sopraelevazione-cadore')[0]}
  briciole={[{ nome: 'Realizzazioni', url: '/realizzazioni/' }]}
>
  <IntestazionePagina
    titolo="Realizzazioni"
    intro="Una selezione dei lavori degli ultimi anni: tetti, sopraelevazioni, facciate, case al grezzo e lavori su misura. Le foto sono scattate in cantiere dalla nostra squadra."
    briciole={[{ nome: 'Realizzazioni', url: '/realizzazioni/' }]}
  />

  <section class="sezione archivio" aria-label="Elenco dei lavori">
    <div class="contenitore">
      <fieldset class="archivio__filtri">
        <legend class="solo-lettori">Mostra</legend>
        <label><input type="radio" name="categoria" value="tutti" checked /><span>Tutti</span></label>
        {
          categorie.map(([k, v]) => (
            <label>
              <input type="radio" name="categoria" value={k} />
              <span>{v}</span>
            </label>
          ))
        }
      </fieldset>

      <ul class="archivio__elenco" role="list">
        {
          lavori.map((r, i) => {
            const luogo = luogoDi(r);
            const foto = fotoDi(r.data.cartella);
            return (
              <li class="archivio__voce" data-categoria={r.data.categoria}>
                <a href={`/realizzazioni/${r.id}/`}>
                  <div class="archivio__foto">
                    <Image src={foto[r.data.copertina - 1]!} alt="" widths={[400, 640, 900]} sizes="(min-width: 64rem) 31vw, (min-width: 40rem) 46vw, 100vw" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} quality={66} layout="none" />
                  </div>
                  <h2>{r.data.titolo}</h2>
                  <p class="secondario">
                    {luogo ? `${luogo}. ` : ''}
                    {r.data.sintesi}
                  </p>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
  <Fragment set:html={`<style>${filtro}</style>`} />
</Base>

<style>
  .archivio {
    padding-top: 0;
  }
  .archivio__filtri {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 0;
    padding: 0;
    margin: 0 0 2.5rem;
  }
  .archivio__filtri label {
    position: relative;
  }
  .archivio__filtri input {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .archivio__filtri span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--abete);
    border-radius: 999px;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .archivio__filtri input:checked + span {
    background: var(--abete);
    color: var(--neve);
  }
  .archivio__filtri input:focus-visible + span {
    outline: 2px solid var(--larice);
    outline-offset: 3px;
  }
  .archivio__elenco {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
  }
  @media (min-width: 40rem) {
    .archivio__elenco {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .archivio__elenco {
      grid-template-columns: repeat(3, 1fr);
      gap: 3.5rem 2rem;
    }
  }
  .archivio__voce a {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }
  .archivio__foto {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--calcare-scuro);
    margin-bottom: 0.6rem;
  }
  .archivio__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .archivio__voce a:hover :global(img) {
    transform: scale(1.03);
  }
  .archivio__voce h2 {
    font-size: var(--t-1);
  }
  .archivio__voce p {
    font-size: 0.9375rem;
  }
</style>
