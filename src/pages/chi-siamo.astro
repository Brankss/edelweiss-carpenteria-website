---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import IntestazionePagina from '@/components/IntestazionePagina.astro';
import Metodo from '@/components/Metodo.astro';
import { foto } from '@/lib/foto';

// Testi della squadra dal sito attuale del cliente, riscritti in terza persona
const squadra = [
  { nome: 'Luca', ruolo: 'Titolare', testo: 'Geometra, diplomato in tecnica delle costruzioni in legno alla HTL di Rankweil, in Austria. Carpentiere specializzato con certificazione Certis.' },
  { nome: 'Stefano', ruolo: 'Carpentiere', testo: 'Porta avanti la tradizione di famiglia: è in cantiere da quando aveva 16 anni e segue tutte le novità del settore.' },
  { nome: 'Francesco', ruolo: 'Carpentiere', testo: 'Ha un passato da lattoniere: un aiuto prezioso quando si discutono i dettagli delle coperture più complesse.' },
  { nome: 'Alessio', ruolo: 'Carpentiere', testo: 'Viene dalla falegnameria, dove ha imparato i lavori di fino. Arrampicatore sportivo, in quota si muove con disinvoltura.' },
  { nome: 'Edelberto', ruolo: 'Carpentiere', testo: 'Carpentiere da una vita: ha iniziato quando i tetti si tagliavano a mano. Se in cantiere serve una modifica con segaccio e bindella, è lui il riferimento.' },
  { nome: 'Riccardo', ruolo: 'Carpentiere', testo: 'Ottima manualità e tanta voglia di fare. Prima ha costruito scenografie per teatro e cinema, anche a Cinecittà.' },
];
const abilitazioni = [
  'Gru da cantiere a torre',
  'Sollevatori telescopici fissi e rotativi',
  'Piattaforme di lavoro elevabili',
  'Dispositivi di protezione di terza categoria, per il lavoro in quota',
  'Prevenzione incendi e primo soccorso',
];
const mosaico = [
  { n: 5, alt: 'Un carpentiere fissa con l’avvitatore i travetti di una copertura' },
  { n: 7, alt: 'Due carpentieri tagliano una trave con la sega circolare in cantiere' },
  { n: 6, alt: 'Un carpentiere sul tavolato di un tetto in costruzione, in mezzo alla campagna' },
  { n: 4, alt: 'Un carpentiere sega i pannelli di una parete in legno sul ponteggio' },
];
---

<Base
  titolo="Chi siamo: la squadra di Edelweiss Carpenteria"
  descrizione="Edelweiss Carpenteria è una carpenteria del legno di Trento guidata da Luca Di Bello, diplomato alla HTL di Rankweil. Conoscete la squadra che monta i vostri tetti."
  immagine={foto('squadra', 1)}
  briciole={[{ nome: 'Chi siamo', url: '/chi-siamo/' }]}
>
  <IntestazionePagina
    titolo="Chi siamo"
    intro="Una carpenteria del legno con sede a Cognola, sopra Trento. Progettiamo e costruiamo noi quello che vi proponiamo, dal primo sopralluogo all’ultima vite."
    foto={foto('squadra', 1)}
    alt="Un carpentiere della squadra taglia una trave con la sega circolare, con le montagne sullo sfondo"
    posizione="50% 35%"
    briciole={[{ nome: 'Chi siamo', url: '/chi-siamo/' }]}
  />

  <section class="sezione storia" aria-labelledby="storia-titolo">
    <div class="contenitore storia__griglia">
      <figure class="storia__foto">
        <div class="foto rivela">
          <Image src={foto('squadra', 2)} alt="Luca Di Bello dentro una struttura in pannelli di legno in cantiere" widths={[480, 720, 960]} sizes="(min-width: 64rem) 36vw, 100vw" loading="lazy" quality={68} layout="none" />
        </div>
        <figcaption class="secondario">Luca Di Bello, titolare</figcaption>
      </figure>
      <div class="storia__testo">
        <h2 id="storia-titolo" class="t-h2">Dal Vorarlberg a Trento.</h2>
        <div class="prosa">
          <p>
            Dopo il diploma di geometra, Luca Di Bello è andato a specializzarsi in Austria, alla HTL di Rankweil, nel Vorarlberg: una delle
            regioni d’Europa dove l’architettura in legno contemporanea è nata e cresciuta. Lì ha preso il diploma austriaco in tecnica delle
            costruzioni in legno.
          </p>
          <p>
            Tornato in Italia ha ottenuto la certificazione Certis di carpentiere specializzato e ha lavorato per anni tra ufficio tecnico e
            cantiere. Poi ha fondato Edelweiss Carpenteria.
          </p>
          <p>
            Oggi lavoriamo sia con gli studi tecnici sia direttamente con le famiglie. La struttura è piccola e agile: possiamo seguire una
            tettoia come una casa intera, con le stesse persone dall’inizio alla fine.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sezione squadra" aria-labelledby="squadra-titolo">
    <div class="contenitore">
      <h2 id="squadra-titolo" class="t-h2">La squadra</h2>
      <ul role="list" class="squadra__elenco">
        {
          squadra.map((p) => (
            <li>
              <h3 class="squadra__nome">{p.nome}</h3>
              <p class="squadra__ruolo">{p.ruolo}</p>
              <p class="secondario">{p.testo}</p>
            </li>
          ))
        }
      </ul>
      <ul role="list" class="mosaico">
        {
          mosaico.map((m, i) => (
            <li class={`mosaico__voce mosaico__voce--${i + 1}`}>
              <div class="foto rivela">
                <Image src={foto('squadra', m.n)} alt={m.alt} widths={[360, 540, 720, 960]} sizes={i === 0 ? '(min-width: 64rem) 50vw, 100vw' : '(min-width: 64rem) 25vw, 50vw'} loading="lazy" quality={64} layout="none" />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sezione abilitazioni" aria-labelledby="abil-titolo">
    <div class="contenitore abilitazioni__griglia">
      <div>
        <h2 id="abil-titolo" class="t-h2">Abilitazioni</h2>
        <p class="t-lead">Ogni persona in cantiere ha i patentini per il lavoro che fa.</p>
      </div>
      <ul role="list" class="abilitazioni__elenco">
        {abilitazioni.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <Metodo />
</Base>

<style>
  .storia__griglia {
    display: grid;
    gap: 3rem;
  }
  .storia__foto {
    display: grid;
    gap: 0.75rem;
    font-size: var(--t-piccolo);
  }
  .storia__foto .foto {
    aspect-ratio: 4 / 5;
  }
  .storia__testo {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  @media (min-width: 64rem) {
    .storia__griglia {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 6rem;
      align-items: center;
    }
  }

  .squadra .t-h2 {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .squadra__elenco {
    display: grid;
    gap: 2.5rem 2rem;
  }
  .squadra__elenco li {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea);
  }
  .squadra__nome {
    font-size: var(--t-h3);
    font-weight: 300;
    letter-spacing: -0.03em;
  }
  .squadra__ruolo {
    font-size: var(--t-piccolo);
    color: var(--cuoio);
    margin-bottom: 0.4rem;
  }
  @media (min-width: 40rem) {
    .squadra__elenco {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .squadra__elenco {
      grid-template-columns: repeat(3, 1fr);
      gap: 3.5rem 2.5rem;
    }
  }

  .mosaico {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }
  .mosaico .foto {
    aspect-ratio: 1;
    height: 100%;
  }
  .mosaico__voce--1 {
    grid-column: 1 / -1;
  }
  .mosaico__voce--1 .foto {
    aspect-ratio: 16 / 10;
  }
  @media (min-width: 64rem) {
    .mosaico {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 1.25rem;
    }
    .mosaico__voce--1 {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .mosaico__voce--1 .foto {
      aspect-ratio: auto;
    }
    .mosaico__voce--4 {
      grid-column: 2 / span 2;
    }
    .mosaico__voce--4 .foto {
      aspect-ratio: 2 / 1;
    }
  }

  .abilitazioni__griglia {
    display: grid;
    gap: 2.5rem;
  }
  .abilitazioni__griglia > div {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .abilitazioni__elenco {
    display: grid;
    gap: 0;
    counter-reset: abil;
  }
  .abilitazioni__elenco li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.1rem;
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 300;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .abilitazioni__elenco li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--cuoio);
    transform: translateY(-0.15rem);
  }
  @media (min-width: 64rem) {
    .abilitazioni__griglia {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
    }
  }
</style>
