---
// Elenco dei servizi. Su desktop, passando sopra un nome cambia l'unica foto a destra (solo CSS).
import { Image } from 'astro:assets';
import { servizi } from '@/data/servizi';

const scambio = servizi
  .map((_, i) => {
    const n = i + 1;
    return `.servizi:has(.servizi__voce:nth-child(${n}) a:is(:hover, :focus-visible)) .servizi__foto img:nth-child(${n}) { opacity: 1; }`;
  })
  .join('\n');
---

<section class="sezione" aria-labelledby="servizi-titolo">
  <div class="contenitore servizi">
    <div class="servizi__elenco">
      <h2 id="servizi-titolo">Cosa costruiamo</h2>
      <ul>
        {
          servizi.map((s) => (
            <li class="servizi__voce">
              <a href={`/${s.slug}/`}>
                <Image
                  class="servizi__mini"
                  src={s.copertina}
                  alt=""
                  width={88}
                  height={88}
                  fit="cover"
                  layout="fixed"
                  loading="lazy"
                  quality={65}
                />
                <span class="servizi__nome">{s.nome}</span>
                <span class="servizi__riga">{s.riga}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="servizi__foto capanna" aria-hidden="true">
      {
        servizi.map((s) => (
          <Image src={s.copertina} alt="" widths={[480, 720, 960]} sizes="(min-width: 64rem) 38vw, 0px" loading="lazy" quality={68} layout="none" />
        ))
      }
    </div>
  </div>
</section>

<Fragment set:html={`<style>${scambio}</style>`} />

<style>
  .servizi {
    display: grid;
    gap: 3rem;
  }
  .servizi__elenco h2 {
    margin-bottom: 2rem;
  }
  .servizi ul {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--nebbia);
  }
  .servizi__voce {
    border-bottom: 1px solid var(--nebbia);
  }
  .servizi__voce a {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    grid-template-rows: auto auto;
    column-gap: 1.1rem;
    row-gap: 0.25rem;
    align-items: center;
    padding-block: 1rem;
    text-decoration: none;
  }
  .servizi :global(.servizi__mini) {
    grid-row: 1 / 3;
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
  }
  .servizi__nome {
    align-self: end;
    font-size: var(--t-2);
    font-weight: 540;
    font-stretch: 122%;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .servizi__riga {
    align-self: start;
    color: var(--nebbia-testo);
    font-size: 0.9375rem;
  }
  .servizi__foto {
    display: none;
  }

  @media (min-width: 64rem) {
    .servizi {
      grid-template-columns: 7fr 5fr;
      gap: 5rem;
      align-items: start;
    }
    .servizi__voce a {
      grid-template-columns: 1fr;
      padding-block: 1.4rem;
      transition: padding 0.25s ease;
    }
    .servizi :global(.servizi__mini) {
      display: none;
    }
    .servizi__elenco h2 {
      font-size: var(--t-4);
      margin-bottom: 2.5rem;
    }
    .servizi__nome {
      font-size: clamp(1.75rem, 1rem + 1.4vw, 2.35rem);
      transition: color 0.2s ease;
    }
    .servizi__riga {
      font-size: var(--t-base);
    }
    .servizi__voce a:hover .servizi__nome,
    .servizi__voce a:focus-visible .servizi__nome {
      color: var(--larice);
    }
    .servizi__foto {
      --gronda: 30%;
      display: grid;
      position: sticky;
      top: 2rem;
      aspect-ratio: 4 / 5;
      background: var(--calcare-scuro);
    }
    .servizi__foto :global(img) {
      grid-area: 1 / 1;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    .servizi__foto :global(img:first-child) {
      opacity: 1;
    }
    .servizi:has(.servizi__voce:not(:first-child) a:is(:hover, :focus-visible)) .servizi__foto :global(img:first-child) {
      opacity: 0;
    }
  }
</style>
