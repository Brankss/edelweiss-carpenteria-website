---
// Modello delle pagine servizio: apertura con foto, cosa facciamo, tre foto di cantiere, lavori collegati, domande.
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import IntestazionePagina from './IntestazionePagina.astro';
import SchedaProgetto from './SchedaProgetto.astro';
import Domande from './Domande.astro';
import type { Servizio } from '@/data/servizi';
import { realizzazioni } from '@/lib/foto';

interface Props {
  servizio: Servizio;
}
const { servizio: s } = Astro.props;
const url = `/${s.slug}/`;
const sito = Astro.site!.href.replace(/\/$/, '');

const lavori = (await realizzazioni()).filter((r) => s.categorie.includes(r.data.categoria)).slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.h1,
    description: s.descrizione,
    url: new URL(url, Astro.site).href,
    provider: { '@id': `${sito}/#impresa` },
    areaServed: { '@type': 'AdministrativeArea', name: 'Provincia autonoma di Trento' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faq.map((q) => ({ '@type': 'Question', name: q.d, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
  },
];
---

<Base titolo={s.titoloSeo} descrizione={s.descrizione} immagine={s.copertina} briciole={[{ nome: s.nome, url }]} jsonLd={jsonLd}>
  <IntestazionePagina titolo={s.h1} intro={s.intro} briciole={[{ nome: s.nome, url }]} foto={s.copertina} alt={s.altCopertina} />

  <section class="sezione dettagli" aria-label={`${s.h1}: cosa facciamo`}>
    <div class="contenitore">
      <div class="dettagli__elenco">
        {
          s.sezioni.map((x) => (
            <div class="dettaglio">
              <h2 class="dettaglio__titolo">{x.titolo}</h2>
              <div class="dettaglio__testo">
                {x.testo.map((t) => (
                  <p>{t}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <slot />

  <section class="sezione striscia" aria-label="Foto di cantiere">
    <div class="contenitore striscia__griglia">
      {
        s.striscia.map((f, i) => (
          <figure class={`striscia__voce striscia__voce--${i + 1}`}>
            <div class="foto rivela">
              <Image
                src={f.foto}
                alt=""
                widths={[480, 720, 960, 1280]}
                sizes={i === 0 ? '(min-width: 64rem) 58vw, 100vw' : '(min-width: 64rem) 38vw, 100vw'}
                quality={64}
                loading="lazy"
                layout="none"
              />
            </div>
            <figcaption>{f.alt}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {
    lavori.length > 0 && (
      <section class="sezione collegati" aria-labelledby="collegati-titolo">
        <div class="contenitore">
          <div class="collegati__testa">
            <h2 id="collegati-titolo" class="t-h2">
              Lavori di {s.nome.toLowerCase()}
            </h2>
            <a class="collegamento" href="/realizzazioni/">
              Tutte le realizzazioni
            </a>
          </div>
          <ul role="list" class="collegati__griglia">
            {lavori.map((r) => (
              <li>
                <SchedaProgetto r={r} sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Domande domande={s.faq} />
</Base>

<style>
  .dettagli__elenco {
    display: grid;
  }
  .dettaglio {
    display: grid;
    gap: 0.9rem;
    padding-block: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--linea);
  }
  .dettaglio:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .dettaglio__titolo {
    font-size: var(--t-h3);
    font-weight: 400;
  }
  .dettaglio__testo {
    display: grid;
    gap: 1em;
    max-width: 38rem;
    margin: 0;
    color: var(--testo-2);
  }
  @media (min-width: 64rem) {
    .dettaglio {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
    .dettaglio__titolo {
      position: sticky;
      top: calc(var(--testata) + 2rem);
    }
  }

  .striscia__griglia {
    display: grid;
    gap: 2rem;
  }
  .striscia__voce {
    display: grid;
    gap: 0.75rem;
  }
  .striscia__voce .foto {
    aspect-ratio: 4 / 3;
  }
  .striscia__voce figcaption {
    font-size: var(--t-piccolo);
    color: var(--testo-2);
    max-width: 30rem;
  }
  @media (min-width: 64rem) {
    .striscia__griglia {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      row-gap: 3rem;
      align-items: start;
    }
    .striscia__voce--1 {
      grid-column: 1 / span 7;
      grid-row: span 2;
    }
    .striscia__voce--1 .foto {
      aspect-ratio: 4 / 5;
    }
    .striscia__voce--2 {
      grid-column: 9 / span 4;
      margin-top: 6rem;
    }
    .striscia__voce--3 {
      grid-column: 8 / span 5;
    }
  }

  .collegati__testa {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .collegati__griglia {
    display: grid;
    gap: 3rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .collegati__griglia {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .collegati__griglia {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
