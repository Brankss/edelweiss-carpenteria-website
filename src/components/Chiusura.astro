---
// Il blocco in porfido: unico uso del colore nel sito. Contiene la richiesta di sopralluogo e il piè di pagina.
import Logo from './Logo.astro';
import ModuloSopralluogo from './ModuloSopralluogo.astro';
import { azienda, navigazione } from '@/data/sito';

interface Props {
  modulo?: boolean;
}
const { modulo = false } = Astro.props;
const anno = new Date().getFullYear();
---

<footer class="chiusura chiaro">
  {
    modulo ? (
      <section class="contenitore chiusura__richiesta" id="richiesta" aria-labelledby="richiesta-titolo">
        <div class="chiusura__intro">
          <h2 id="richiesta-titolo">Richiedi un sopralluogo gratuito</h2>
          <p>
            Raccontateci cosa volete costruire o sistemare. Vi richiamiamo per fissare un appuntamento: veniamo a vedere, misuriamo e
            vi lasciamo un preventivo senza impegno.
          </p>
          <ul class="chiusura__diretti">
            <li>
              <a href={azienda.telefonoLink}>{azienda.telefono}</a>
            </li>
            <li>
              <a href={azienda.whatsapp}>WhatsApp</a>
            </li>
            <li>
              <a href={`mailto:${azienda.email}`}>{azienda.email}</a>
            </li>
          </ul>
        </div>
        <ModuloSopralluogo />
      </section>
    ) : (
      <section class="contenitore chiusura__invito" aria-labelledby="invito-titolo">
        <h2 id="invito-titolo">Parliamo del vostro progetto</h2>
        <div class="chiusura__azioni">
          <a class="pulsante" href="/contatti/#richiesta">Richiedi un sopralluogo</a>
          <a class="pulsante pulsante--vuoto" href={azienda.telefonoLink}>Chiama {azienda.telefono}</a>
        </div>
      </section>
    )
  }

  <div class="contenitore chiusura__info">
    <div class="chiusura__marchio">
      <Logo />
    </div>
    <div>
      <h3>Dove siamo</h3>
      <address>
        {azienda.indirizzo.via}, {azienda.indirizzo.frazione}<br />
        {azienda.indirizzo.cap} {azienda.indirizzo.citta} ({azienda.indirizzo.provincia})
      </address>
      <a href={azienda.mappa} rel="noopener">Apri in Google Maps</a>
    </div>
    <div>
      <h3>Orari</h3>
      <dl class="chiusura__orari">
        {
          azienda.orari.map((o) => (
            <div>
              <dt>{o.giorni}</dt>
              <dd>{o.ore}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <nav aria-label="Pagine">
      <h3>Pagine</h3>
      <ul>
        {
          navigazione.map((v) => (
            <li>
              <a href={v.href}>{v.label}</a>
            </li>
          ))
        }
        <li><a href="/perche-il-legno/">Perché il legno</a></li>
      </ul>
    </nav>
  </div>

  <div class="contenitore chiusura__legale">
    <p>
      {
        [
          `${azienda.ragioneSociale}, ${azienda.indirizzo.via}, ${azienda.indirizzo.cap} ${azienda.indirizzo.citta}`,
          `P.IVA ${azienda.piva}`,
          azienda.rea && `REA ${azienda.rea}`,
          azienda.pec && `PEC ${azienda.pec}`,
        ]
          .filter(Boolean)
          .join('. ')
      }
    </p>
    <ul>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/cookie/">Cookie</a></li>
      <li><a href="/note-legali/">Note legali</a></li>
      <li><a href={azienda.social.facebook} rel="noopener">Facebook</a></li>
      <li><a href={azienda.social.instagram} rel="noopener">Instagram</a></li>
    </ul>
    <p class="chiusura__anno">© {anno}</p>
  </div>
</footer>

<style>
  .chiusura {
    background: var(--porfido);
    color: var(--neve);
  }
  .chiusura a {
    color: inherit;
  }
  .chiusura__richiesta,
  .chiusura__invito {
    padding-block: var(--sezione);
    border-bottom: 1px solid rgb(247 247 244 / 0.2);
  }
  .chiusura__richiesta {
    display: grid;
    gap: 3rem;
  }
  .chiusura__intro {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .chiusura__intro p {
    max-width: 30rem;
  }
  .chiusura__diretti {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-weight: 540;
  }
  .chiusura__diretti a {
    text-decoration-color: rgb(247 247 244 / 0.4);
  }
  @media (min-width: 64rem) {
    .chiusura__richiesta {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }
  .chiusura__invito {
    display: grid;
    gap: 2rem;
  }
  .chiusura__invito h2 {
    font-size: var(--t-4);
    max-width: 14ch;
  }
  .chiusura__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 64rem) {
    .chiusura__invito {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .chiusura__info {
    display: grid;
    gap: 2rem;
    padding-block: 3.5rem;
    font-size: 0.9375rem;
  }
  .chiusura__info h3 {
    font-size: 0.9375rem;
    font-stretch: 112%;
    margin-bottom: 0.6rem;
    opacity: 0.75;
  }
  .chiusura__info address {
    font-style: normal;
    margin-bottom: 0.4rem;
  }
  .chiusura__info ul {
    list-style: none;
    padding: 0;
    columns: 2;
    column-gap: 1.5rem;
  }
  .chiusura__info li {
    padding-block: 0.15rem;
  }
  .chiusura__orari div + div {
    margin-top: 0.5rem;
  }
  .chiusura__orari dd {
    margin: 0;
    opacity: 0.85;
  }
  @media (min-width: 48rem) {
    .chiusura__info {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .chiusura__info {
      grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    }
  }
  .chiusura__legale {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    align-items: baseline;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(247 247 244 / 0.2);
    font-size: 0.8125rem;
    color: rgb(247 247 244 / 0.82);
  }
  .chiusura__legale ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
  }
  .chiusura__legale a {
    display: inline-block;
    padding-block: 0.35rem;
  }
  .chiusura__anno {
    margin-left: auto;
  }
</style>
