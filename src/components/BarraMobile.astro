---
import { azienda } from '@/data/sito';
---

<nav class="barra" aria-label="Contatto rapido">
  <a href={azienda.telefonoLink}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h3l1.4 4.2-2 1.4a12 12 0 0 0 5.9 5.9l1.4-2 4.2 1.4v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"></path></svg>
    Chiama
  </a>
  <a href={azienda.whatsapp}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6Z"></path><path d="M9.2 8.6c.3 2.6 2.4 5 5.2 5.6l1.1-1.2"></path></svg>
    WhatsApp
  </a>
  <a href="/contatti/#richiesta" class="barra__principale">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 9.5V20h13V9.5"></path></svg>
    Sopralluogo
  </a>
</nav>

<style>
  .barra {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr 1fr 1.25fr;
    gap: 1px;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--abete);
    border-top: 1px solid rgb(247 247 244 / 0.12);
  }
  .barra a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: 4rem;
    color: var(--neve);
    font-size: 0.8125rem;
    font-weight: 540;
    text-decoration: none;
  }
  .barra__principale {
    background: var(--larice);
  }
  .barra svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 48rem) {
    .barra {
      display: none;
    }
  }
</style>
