---
// Barra in basso su mobile, a portata di pollice. Si nasconde quando sullo schermo c'è già un invito (hero, modulo, footer).
import Icona from './Icona.astro';
import { azienda, CTA } from '@/data/sito';
---

<div class="barra" data-barra data-nascosta>
  <a class="pulsante pulsante--vuoto barra__chiama" href={azienda.telefonoLink} aria-label={`Chiama ${azienda.telefono}`}>
    <Icona nome="telefono" /> Chiama
  </a>
  <a class="pulsante barra__cta" href={CTA.href}>{CTA.label}</a>
</div>

<style>
  .barra {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-barra);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    padding: 0.625rem max(var(--margine), env(safe-area-inset-left)) calc(0.625rem + env(safe-area-inset-bottom));
    background: rgb(13 13 11 / 0.88);
    border-top: 1px solid var(--linea);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    transition:
      transform 0.45s var(--curva),
      visibility 0.45s;
  }
  .barra[data-nascosta] {
    transform: translateY(110%);
    visibility: hidden;
  }
  .barra .pulsante {
    min-height: 3rem;
    padding-inline: 1.1rem;
    font-size: 0.9375rem;
  }
  .barra__chiama {
    background: var(--fondo);
  }
  @media (min-width: 64rem) {
    .barra {
      display: none;
    }
  }
</style>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  if (barra) {
    const visibili = new Set<Element>();
    let bloccata = false;
    const aggiorna = () => barra.toggleAttribute('data-nascosta', bloccata || visibili.size > 0);
    const osservatore = new IntersectionObserver(
      (voci) => {
        for (const v of voci) v.isIntersecting ? visibili.add(v.target) : visibili.delete(v.target);
        aggiorna();
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('[data-nascondi-barra]').forEach((el) => osservatore.observe(el));
    // Mentre il banner dei cookie è aperto la barra resta nascosta, per non sovrapporsi
    document.addEventListener('edw:consenso-aperto', () => {
      bloccata = true;
      aggiorna();
    });
    document.addEventListener('edw:consenso-chiuso', () => {
      bloccata = false;
      aggiorna();
    });
    // L'osservatore richiama sempre "aggiorna" al primo controllo: la barra compare solo se nessun invito è visibile
  }
</script>
