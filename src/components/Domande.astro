---
// Domande frequenti: <details> nativi (tastiera e lettori di schermo funzionano senza JS).
// L'apertura è animata dove il browser supporta ::details-content.
import Icona from './Icona.astro';
import type { Faq } from '@/data/servizi';

interface Props {
  domande: Faq[];
  titolo?: string;
}
const { domande, titolo = 'Domande frequenti' } = Astro.props;
---

<section class="sezione domande" aria-labelledby="domande-titolo">
  <div class="contenitore domande__griglia">
    <h2 id="domande-titolo" class="t-h2">{titolo}</h2>
    <div class="domande__elenco">
      {
        domande.map((q) => (
          <details name="domande">
            <summary>
              <span>{q.d}</span>
              <Icona nome="piu" dimensione="1.5rem" class="domande__icona" />
            </summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .domande__griglia {
    display: grid;
    gap: 2.5rem;
  }
  .domande__elenco {
    border-top: 1px solid var(--linea);
  }
  details {
    border-bottom: 1px solid var(--linea);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-block: 1.25rem;
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.35rem);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--cuoio);
  }
  summary :global(.domande__icona) {
    flex: none;
    color: var(--cuoio);
    transition: transform 0.45s var(--curva);
  }
  details[open] summary :global(.domande__icona) {
    transform: rotate(45deg);
  }
  details p {
    max-width: 42rem;
    padding-bottom: 1.5rem;
    color: var(--testo-2);
  }
  @supports (interpolate-size: allow-keywords) {
    .domande {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.5s var(--curva),
        content-visibility 0.5s allow-discrete;
    }
    details[open]::details-content {
      height: auto;
    }
  }
  @media (min-width: 64rem) {
    .domande__griglia {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }
</style>
