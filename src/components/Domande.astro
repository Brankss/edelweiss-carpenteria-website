---
import type { Faq } from '@/data/servizi';

interface Props {
  domande: Faq[];
  titolo?: string;
}
const { domande, titolo = 'Domande frequenti' } = Astro.props;
---

<section class="sezione domande" aria-labelledby="domande-titolo">
  <div class="contenitore domande__griglia">
    <h2 id="domande-titolo">{titolo}</h2>
    <div class="domande__elenco">
      {
        domande.map((q) => (
          <details name="domande">
            <summary>{q.d}</summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .domande__griglia {
    display: grid;
    gap: 2rem;
  }
  .domande__elenco {
    border-top: 1px solid var(--nebbia);
  }
  details {
    border-bottom: 1px solid var(--nebbia);
  }
  summary {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    min-height: 3.75rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--t-1);
    font-weight: 540;
    font-stretch: 110%;
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-25%);
    transition: transform 0.2s ease;
  }
  details[open] summary::after {
    transform: rotate(225deg) translateY(-25%);
  }
  details p {
    padding-bottom: 1.5rem;
    max-width: 40rem;
    color: var(--nebbia-testo);
  }
  @media (min-width: 64rem) {
    .domande__griglia {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
    }
  }
</style>
