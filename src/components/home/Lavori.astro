---
// Realizzazioni in home, su una fascia chiara color pietra. Il modello 3D si rimpicciolisce e si sposta a destra
// come un plastico sul tavolo, le foto vere stanno a sinistra (mai più larghe della loro risoluzione).
import SchedaProgetto from '@/components/SchedaProgetto.astro';
import { realizzazioni } from '@/lib/foto';

const tutte = await realizzazioni();
const scelte = tutte.filter((r) => r.data.inEvidenza).slice(0, 6);
---

<section class="lavori" data-capitolo="lavori" data-banda="chiara" aria-labelledby="lavori-titolo">
  <div class="contenitore lavori__corpo">
    <div class="lavori__testa">
      <h2 id="lavori-titolo" class="lavori__titolo">Dal modello ai cantieri veri.</h2>
      <p class="lavori__intro">Il modello qui accanto è un esempio. Questi sono lavori nostri, fotografati dalla squadra durante il montaggio.</p>
      <a class="collegamento lavori__link" href="/realizzazioni/">Tutte le realizzazioni</a>
    </div>
    <ul role="list" class="lavori__griglia">
      {
        scelte.map((r) => (
          <li>
            <SchedaProgetto r={r} sizes="(min-width: 64rem) 28vw, (min-width: 40rem) 45vw, 100vw" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lavori {
    padding-block: clamp(6rem, 14svh, 10rem);
  }
  .lavori__testa {
    display: grid;
    gap: 1rem;
    max-width: 30rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .lavori__titolo {
    font-size: var(--t-h2);
  }
  .lavori__intro {
    font-size: var(--t-lead);
    color: var(--testo-2);
  }
  .lavori__link {
    justify-self: start;
  }
  .lavori__griglia {
    display: grid;
    gap: 2.5rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .lavori__griglia {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* Desktop: tutto nella parte sinistra, a destra resta il plastico */
  @media (min-width: 64rem) {
    .lavori__corpo > * {
      max-width: 60%;
    }
    .lavori__testa {
      max-width: 30rem;
    }
    .lavori__griglia {
      row-gap: 3rem;
    }
  }
</style>
