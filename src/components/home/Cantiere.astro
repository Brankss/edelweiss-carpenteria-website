---
// Il cantiere 3D: fisso dietro tutta la home. Finché la scena non è pronta (e sempre con "riduci movimento"
// o senza WebGL) si vede l'immagine statica dello stesso modello.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import posterLargo from '@/assets/render/cantiere-progetto-largo.jpg';
import posterAlto from '@/assets/render/cantiere-progetto-alto.jpg';
import finitaLarga from '@/assets/render/cantiere-finita-largo.png';
import finitaAlta from '@/assets/render/cantiere-finita-alto.png';

// Un solo <picture> per immagine: il browser scarica solo la versione che serve (orizzontale o verticale),
// e la casa finita solo a chi ha attivato "riduci movimento"
const srcset = async (src: ImageMetadata, larghezze: number[], format: 'avif' | 'webp', quality: number) =>
  (await Promise.all(larghezze.map((width) => getImage({ src, width, format, quality })))).map((g, i) => `${g.src} ${larghezze[i]}w`).join(', ');
const vuota = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const progetto = {
  largoAvif: await srcset(posterLargo, [1280, 1920], 'avif', 55),
  largoWebp: await srcset(posterLargo, [1280, 1920], 'webp', 70),
  altoAvif: await srcset(posterAlto, [480, 780], 'avif', 55),
  altoWebp: await srcset(posterAlto, [480, 780], 'webp', 70),
};
const finita = {
  largo: await srcset(finitaLarga, [1280, 1920], 'avif', 50),
  alto: await srcset(finitaAlta, [480, 780], 'avif', 50),
};
const MOTO = '(prefers-reduced-motion: no-preference)';
const FERMO = '(prefers-reduced-motion: reduce)';

const etichette = [
  ['xlam', 'Pannelli XLAM'],
  ['solaio', 'Solaio in XLAM'],
  ['telaio', 'Parete a telaio'],
  ['colmo', 'Trave di colmo'],
  ['manto', 'Manto di copertura'],
  ['doghe', 'Doghe in larice'],
  ['pergola', 'Pergola'],
  ['quotaL', '10,40 m'],
  ['quotaP', '8,00 m'],
  ['falda', 'Falda a 30°'],
] as const;
---

<div class="cantiere" data-gsap="cantiere" aria-hidden="true">
  <picture class="cantiere__poster cantiere__poster--progetto">
    <source media={`${MOTO} and (orientation: landscape)`} type="image/avif" srcset={progetto.largoAvif} sizes="100vw" />
    <source media={`${MOTO} and (orientation: landscape)`} type="image/webp" srcset={progetto.largoWebp} sizes="100vw" />
    <source media={MOTO} type="image/avif" srcset={progetto.altoAvif} sizes="100vw" />
    <source media={MOTO} type="image/webp" srcset={progetto.altoWebp} sizes="100vw" />
    <img src={vuota} alt="" fetchpriority="high" decoding="async" />
  </picture>
  <picture class="cantiere__poster cantiere__poster--finita">
    <source media={`${FERMO} and (orientation: landscape)`} type="image/avif" srcset={finita.largo} sizes="100vw" />
    <source media={FERMO} type="image/avif" srcset={finita.alto} sizes="100vw" />
    <img src={vuota} alt="" decoding="async" />
  </picture>
  <canvas class="cantiere__tela" data-tela></canvas>
  <div class="cantiere__etichette">
    {
      etichette.map(([k, testo]) => (
        <span class:list={['etichetta', { 'etichetta--quota': k.startsWith('quota') }]} data-etichetta={k}>
          <span>{testo}</span>
        </span>
      ))
    }
  </div>
  <div class="cantiere__velo"></div>
</div>

<style>
  .cantiere {
    position: fixed;
    inset: 0;
    height: 100lvh;
    z-index: 1;
    pointer-events: none;
  }
  .cantiere__tela,
  .cantiere__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cantiere__tela {
    opacity: 0;
    transition: opacity 0.9s var(--curva);
  }
  :global(.cantiere--pronto) .cantiere__tela {
    opacity: 1;
  }
  /* Schermi verticali: sulle fasce pietra e tavola il testo scorre su tutta la larghezza,
     quindi la casa sfuma e lascia spazio ai contenuti (--velo = 1 - presenza della fascia) */
  @media (orientation: portrait) {
    :global(.cantiere--pronto) .cantiere__tela {
      opacity: var(--velo, 1);
      transition: opacity 0.45s var(--curva);
    }
  }
  .cantiere__poster {
    transition: opacity 0.9s var(--curva);
  }
  .cantiere__poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Con il movimento: prima il progetto, poi la tela. Senza movimento: la casa finita, ferma. */
  .cantiere__poster--finita {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .cantiere__poster--progetto {
      opacity: 0;
    }
    .cantiere__poster--finita {
      opacity: 1;
    }
  }
  :global(.cantiere--pronto) .cantiere__poster {
    opacity: 0;
  }

  /* Velature per la leggibilità del testo: a sinistra su schermi larghi, in basso su quelli alti */
  .cantiere__velo {
    position: absolute;
    inset: 0;
    /* si spegne sulle fasce chiare e sulla tavola tecnica (lo script scrive --velo) */
    opacity: var(--velo, 1);
    transition: opacity 0.45s var(--curva);
    background: linear-gradient(to top, rgb(13 13 11 / 0.92) 0%, rgb(13 13 11 / 0.55) 30%, rgb(13 13 11 / 0) 52%);
  }
  @media (orientation: landscape) and (min-width: 64rem) {
    .cantiere__velo {
      background: linear-gradient(to right, rgb(13 13 11 / 0.88) 0%, rgb(13 13 11 / 0.5) 34%, rgb(13 13 11 / 0) 55%);
    }
  }

  /* Etichette tecniche agganciate ai pezzi */
  .cantiere__etichette {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .etichetta {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    transition: opacity 0.5s var(--curva);
    will-change: transform;
  }
  .etichetta[data-visibile] {
    opacity: 1;
  }
  .etichetta::before {
    content: '';
    position: absolute;
    left: -3px;
    top: -3px;
    width: 7px;
    height: 7px;
    border: 1px solid var(--cuoio);
    background: var(--fondo);
  }
  .etichetta::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 0;
    width: 2.25rem;
    height: 1px;
    background: var(--cuoio);
    transform: rotate(-35deg);
    transform-origin: left center;
  }
  .etichetta[data-sinistra]::after {
    left: auto;
    right: 4px;
    transform: rotate(35deg);
    transform-origin: right center;
  }
  .etichetta[data-sinistra] > span {
    left: auto;
    right: calc(1.85rem + 2px);
  }
  /* Quote: solo il numero, centrato sulla linea di misura */
  .etichetta--quota::before,
  .etichetta--quota::after {
    display: none;
  }
  .etichetta.etichetta--quota > span,
  .etichetta.etichetta--quota[data-sinistra] > span {
    left: 0;
    right: auto;
    top: 0;
    transform: translate(-50%, -50%);
    color: var(--cuoio);
    border-color: rgb(209 172 130 / 0.45);
  }
  .etichetta > span {
    position: absolute;
    left: calc(1.85rem + 2px);
    top: -1.75rem;
    padding: 0.2rem 0.45rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--testo);
    background: rgb(13 13 11 / 0.82);
    border: 1px solid var(--linea-forte);
  }
</style>
