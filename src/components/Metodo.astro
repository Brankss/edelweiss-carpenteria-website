---
// Il metodo: una vera sequenza di quattro fasi. La linea a sinistra si riempie scorrendo (CSS scroll-driven, nessun JS).
// In home ("cantiere") sta in una sola colonna a sinistra, sopra il modello 3D.
interface Props {
  cantiere?: boolean;
}
const { cantiere = false } = Astro.props;
const fasi = [
  {
    titolo: 'Sopralluogo',
    testo: 'Veniamo a vedere il tetto o l’edificio, prendiamo le misure e ascoltiamo cosa vi serve. È gratuito in tutta la provincia di Trento.',
  },
  {
    titolo: 'Progetto in 3D',
    testo: 'Il nostro ufficio tecnico disegna e dimensiona la struttura in 3D con il software SEMA. Ricevete un preventivo chiaro, voce per voce.',
  },
  {
    titolo: 'Preparazione',
    testo: 'Dal modello escono le misure di ogni pezzo. Ogni elemento viene preparato su misura, con materiali certificati e documentati.',
  },
  {
    titolo: 'Montaggio',
    testo: 'La nostra squadra monta con gru e piattaforme, con tutte le abilitazioni per il lavoro in quota. Il cantiere resta aperto il meno possibile.',
  },
];
---

<section
  class:list={['sezione metodo', { 'metodo--cantiere': cantiere }]}
  data-capitolo={cantiere ? 'metodo' : undefined}
  data-banda={cantiere ? 'tavola' : undefined}
  aria-labelledby="metodo-titolo"
>
  <div class="contenitore metodo__griglia">
    <div class="metodo__testa">
      <h2 id="metodo-titolo" class="t-h2">Dal sopralluogo al montaggio.</h2>
      <p class="t-lead">Le stesse persone dall’inizio alla fine, per una tettoia come per una casa intera.</p>
    </div>
    <ol class="metodo__fasi" role="list">
      {
        fasi.map((f) => (
          <li class="fase">
            <h3 class="fase__titolo">{f.titolo}</h3>
            <p class="secondario">{f.testo}</p>
          </li>
        ))
      }
    </ol>
    {
      cantiere && (
        <dl class="cartiglio" aria-label="In sintesi">
          <div>
            <dt>Ufficio tecnico</dt>
            <dd>Edelweiss Carpenteria, Cognola (TN)</dd>
          </div>
          <div>
            <dt>Modellazione</dt>
            <dd>In 3D, con SEMA</dd>
          </div>
          <div>
            <dt>Sopralluogo</dt>
            <dd>Gratuito in provincia di Trento</dd>
          </div>
          <div>
            <dt>Montaggio</dt>
            <dd>La nostra squadra, con gru e piattaforme</dd>
          </div>
        </dl>
      )
    }
  </div>
</section>

<style>
  .metodo__griglia {
    display: grid;
    gap: 3rem;
  }
  .metodo__testa {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .metodo__testa .t-lead {
    max-width: 26rem;
  }
  .metodo__fasi {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-left: 1.75rem;
  }
  /* binario e riempimento */
  .metodo__fasi::before,
  .metodo__fasi::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: var(--linea-forte);
  }
  .metodo__fasi::after {
    background: var(--cuoio);
    transform-origin: top;
    transform: scaleY(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .metodo__fasi::after {
        animation: metodo-riempi linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 62%;
      }
    }
  }
  @keyframes metodo-riempi {
    from {
      transform: scaleY(0);
    }
  }
  .fase {
    position: relative;
    display: grid;
    gap: 0.75rem;
    max-width: 34rem;
  }
  .fase::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem - 4px);
    top: 0.55rem;
    width: 9px;
    height: 9px;
    background: var(--fondo);
    border: 1px solid var(--cuoio);
    z-index: 1;
  }
  .fase__titolo {
    font-size: var(--t-h3);
    font-weight: 400;
  }
  .metodo--cantiere {
    position: relative;
    padding-block: 20svh 30svh;
  }
  .metodo--cantiere .metodo__griglia > * {
    max-width: 34rem;
  }
  .metodo--cantiere .fase {
    padding: 1rem 1.25rem;
    background: rgb(19 33 45 / 0.84);
  }
  .metodo--cantiere .fase__titolo {
    font-family: var(--mono);
    font-size: 1rem;
    letter-spacing: 0.01em;
  }
  /* Cartiglio: il riquadro delle informazioni in basso nelle tavole tecniche */
  .cartiglio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 34rem;
    margin: 1rem 0 0;
    border: 1px solid var(--linea-forte);
    background: rgb(19 33 45 / 0.9);
  }
  .cartiglio > div {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 1rem;
    border-right: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
  }
  .cartiglio > div:nth-child(2n) {
    border-right: 0;
  }
  .cartiglio > div:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .cartiglio dt {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--testo-2);
  }
  .cartiglio dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  @media (max-width: 26rem) {
    .cartiglio {
      grid-template-columns: 1fr;
    }
    .cartiglio > div {
      border-right: 0;
    }
    .cartiglio > div:nth-last-child(2) {
      border-bottom: 1px solid var(--linea);
    }
  }
  @media (min-width: 64rem) {
    .metodo:not(.metodo--cantiere) .metodo__griglia {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 6rem;
    }
    .metodo:not(.metodo--cantiere) .metodo__testa {
      position: sticky;
      top: calc(var(--testata) + 3rem);
      align-self: start;
    }
    .metodo__fasi {
      padding-left: 3rem;
    }
    .fase::before {
      left: calc(-3rem - 4px);
    }
  }
</style>
