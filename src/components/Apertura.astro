---
// Il momento memorabile del sito: la foto ritagliata a capanna che, scorrendo, si apre fino a tutto schermo.
// Solo CSS (scroll-driven animation). Senza supporto o con "riduci movimento" resta la capanna ferma.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  foto: ImageMetadata;
  alt: string;
  didascalia: string;
}
const { foto, alt, didascalia } = Astro.props;
---

<section class="apertura" aria-labelledby="apertura-titolo">
  <div class="contenitore apertura__testo">
    <h1 id="apertura-titolo"><slot name="titolo" /></h1>
    <div class="apertura__lato">
      <slot />
    </div>
  </div>
  <figure class="apertura__figura">
    <div class="apertura__capanna">
      <Picture
        src={foto}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280, 1680]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        layout="none"
        quality={70}
      />
    </div>
    <figcaption class="contenitore">{didascalia}</figcaption>
  </figure>
</section>

<style>
  .apertura {
    padding-top: clamp(1.5rem, 1rem + 3vw, 4rem);
  }
  .apertura__testo {
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .apertura h1 {
    max-width: 13ch;
  }
  .apertura__lato {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }
  .apertura__lato :global(p) {
    max-width: 30rem;
    font-size: var(--t-1);
    line-height: 1.45;
  }
  .apertura__lato :global(.azioni) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 64rem) {
    .apertura__testo {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: 3rem;
    }
  }

  .apertura__capanna {
    /* gli spigoli della capanna si allineano ai margini del contenuto */
    --lato: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    --gronda: 26%;
    aspect-ratio: 4 / 3.5;
    overflow: hidden;
    background: var(--calcare-scuro);
    clip-path: polygon(50% 0, calc(100% - var(--lato)) var(--gronda), calc(100% - var(--lato)) 100%, var(--lato) 100%, var(--lato) var(--gronda));
  }
  .apertura__capanna :global(picture) {
    display: block;
    height: 100%;
  }
  .apertura__capanna :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 78%;
  }
  @media (min-width: 48rem) {
    .apertura__capanna {
      aspect-ratio: 16 / 9;
      --gronda: 34%;
    }
  }
  @media (min-width: 64rem) {
    .apertura__capanna {
      aspect-ratio: 16 / 7.6;
      max-height: 82vh;
      width: 100%;
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .apertura__capanna {
        animation: capanna-si-apre linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 75vh;
      }
    }
  }
  @keyframes capanna-si-apre {
    to {
      clip-path: polygon(50% 0, 100% 0, 100% 100%, 0 100%, 0 0);
    }
  }

  figcaption {
    padding-top: 0.75rem;
    font-size: var(--t-piccolo);
    color: var(--nebbia-testo);
  }
</style>
