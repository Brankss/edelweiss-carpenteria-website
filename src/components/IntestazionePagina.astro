---
// Apertura delle pagine interne: briciole, titolo, introduzione e, se c'è, una foto.
// La foto non supera mai la sua risoluzione originale (le foto di cantiere sono larghe circa 1050 px):
// su desktop sta nella colonna di destra, su mobile sotto il testo a tutta larghezza.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titolo: string;
  intro?: string;
  briciole?: { nome: string; url: string }[];
  foto?: ImageMetadata;
  alt?: string;
  posizione?: string;
}
const { titolo, intro, briciole = [], foto, alt = '', posizione = '50% 50%' } = Astro.props;
---

<header class:list={['apertura', { 'apertura--foto': foto }]}>
  <div class="contenitore apertura__griglia">
    <div class="apertura__testo">
      {
        briciole.length > 0 && (
          <nav aria-label="Percorso" class="briciole">
            <ol role="list">
              <li>
                <a href="/">Home</a>
              </li>
              {briciole.map((b, i) => <li>{i === briciole.length - 1 ? <span aria-current="page">{b.nome}</span> : <a href={b.url}>{b.nome}</a>}</li>)}
            </ol>
          </nav>
        )
      }
      <h1 class="apertura__titolo">{titolo}</h1>
      {intro && <p class="t-lead apertura__intro">{intro}</p>}
      <slot />
    </div>
    {
      foto && (
        <div class="apertura__foto foto">
          <Picture
            src={foto}
            alt={alt}
            widths={[480, 720, 960, Math.min(1280, foto.width)]}
            sizes="(min-width: 64rem) 50vw, 100vw"
            formats={['avif', 'webp']}
            quality={70}
            loading="eager"
            fetchpriority="high"
            style={`object-position:${posizione}`}
          />
        </div>
      )
    }
  </div>
</header>

<style>
  .apertura {
    padding-top: calc(var(--testata) + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .apertura__griglia {
    display: grid;
    gap: 2.5rem;
  }
  .apertura__testo {
    display: grid;
    gap: 1.25rem;
    align-content: end;
  }
  .briciole ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--testo-2);
  }
  .briciole li + li::before {
    content: '/';
    margin-right: 0.6rem;
    color: var(--testo-3);
  }
  .briciole a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--testo-2);
    text-decoration: none;
  }
  .briciole a:hover {
    color: var(--testo);
  }
  .briciole [aria-current] {
    color: var(--testo);
  }
  .apertura__titolo {
    max-width: 14ch;
    font-size: var(--t-h1);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .apertura__intro {
    max-width: 36rem;
  }
  .apertura__foto {
    aspect-ratio: 4 / 3;
    max-width: 48rem;
  }
  .apertura__foto :global(picture) {
    display: contents;
  }
  .apertura__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 64rem) {
    .apertura--foto .apertura__griglia {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
      align-items: end;
    }
    .apertura__foto {
      justify-self: end;
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .apertura__titolo,
    .apertura__intro {
      animation: apertura-sale 0.9s var(--curva) both;
    }
    .apertura__intro {
      animation-delay: 0.1s;
    }
    .apertura__foto {
      animation: apertura-scopre 1.3s var(--curva) 0.15s both;
    }
    .apertura__foto :global(img) {
      animation: apertura-assesta 1.8s var(--curva) 0.15s both;
    }
  }
  @keyframes apertura-sale {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
  @keyframes apertura-scopre {
    from {
      clip-path: inset(0 0 0 100%);
    }
  }
  @keyframes apertura-assesta {
    from {
      scale: 1.12;
    }
  }
</style>
